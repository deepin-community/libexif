===================================================================
--- github-libexif-CVE-2026-32775.orig/libexif/fuji/mnote-fuji-entry.c
+++ github-libexif-CVE-2026-32775/libexif/fuji/mnote-fuji-entry.c
@@ -202,6 +202,9 @@ mnote_fuji_entry_get_value (MnoteFujiEnt
 
 	if (!entry) return (NULL);
 
+	if (maxlen < 1)
+		return NULL;
+
 	memset (val, 0, maxlen);
 	maxlen--;
 
